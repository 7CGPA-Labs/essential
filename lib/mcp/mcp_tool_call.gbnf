# GBNF constraints enforcing strict JSON output matching tools execution signature
root ::= tool-call
tool-call ::= "<tool_call>" json-object "</tool_call>"
json-object ::= "{" ws string-key ws ":" ws json-value (ws "," ws string-key ws ":" ws json-value)* ws "}"
string-key ::= "\"" [a-zA-Z0-9_.-]+ "\""
json-value ::= string-val | number-val | json-object | array-val | boolean-val | "null"
string-val ::= "\"" [^\"]* "\""
number-val ::= [0-9]+ ("." [0-9]+)?
array-val ::= "[" ws (json-value (ws "," ws json-value)*)? ws "]"
boolean-val ::= "true" | "false"
ws ::= [ \t\n\r]*

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Root.plist
  Settings.bundle for the Kingdom AI Server.
  Exposes Model Storage Location, Server IP/Port, and Master Toggle
  in iOS Settings → Kingdom AI Server.
-->
<plist version="1.0">
<dict>
    <key>StringsTable</key>
    <string>Root</string>
    <key>PreferenceSpecifiers</key>
    <array>
        <!-- Group: Model & Storage -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Model &amp; Storage</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>Model Storage</string>
            <key>Key</key>
            <string>model_storage_path</string>
            <key>DefaultValue</key>
            <string>Documents/models/</string>
        </dict>

        <!-- Group: Server Configuration -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Server Configuration</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>Server URL</string>
            <key>Key</key>
            <string>server_url</string>
            <key>DefaultValue</key>
            <string>http://127.0.0.1:8080</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTextFieldSpecifier</string>
            <key>Title</key>
            <string>Server Port</string>
            <key>Key</key>
            <string>server_port</string>
            <key>DefaultValue</key>
            <string>8080</string>
            <key>KeyboardType</key>
            <string>NumberPad</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSToggleSwitchSpecifier</string>
            <key>Title</key>
            <string>Enable Server</string>
            <key>Key</key>
            <string>server_enabled</string>
            <key>DefaultValue</key>
            <false/>
        </dict>

        <!-- Group: Diagnostics -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Diagnostics</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>Server Status</string>
            <key>Key</key>
            <string>server_status</string>
            <key>DefaultValue</key>
            <string>Stopped</string>
        </dict>

        <!-- Group: Developer -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Developer</string>
            <key>FooterText</key>
            <string>Use usbmuxd port forwarding: iproxy 8080 8080</string>
        </dict>
    </array>
</dict>
</plist>

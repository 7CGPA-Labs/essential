<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme inheriting from AppCompat NoActionBar -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#1E293B</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#1E293B</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.CodingSaathi" parent="AppTheme" />

    <!-- Theme applied to the Android Window while the process is starting -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
    </style>
</resources>

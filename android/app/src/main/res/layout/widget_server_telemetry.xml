<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_server_telemetry.xml
  Layout for the Kingdom AI Server home screen widget.
  Displays IP, status, telemetry gauges, and a toggle button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#E0222222">

    <!-- Status & IP row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 Stopped"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ip_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Server Offline"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="end"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Telemetry gauges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CPU: 0.0%"
            android:textColor="#88CC88"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAM: 0/0 MB"
            android:textColor="#88AADD"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Toggle button -->
    <TextView
        android:id="@+id/widget_toggle_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="▶ START"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:background="#44FFFFFF"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
